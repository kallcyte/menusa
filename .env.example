# Public app origin used by the frontend and Better Auth.
PUBLIC_APP_URL=http://localhost:8787

# Optional Vite API origin. Leave empty when the UI and Worker share an origin.
VITE_API_URL=

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-random-64-character-hex-secret

# Superadmin seed — first sign-in with this email is promoted to superadmin.
SUPERADMIN_EMAIL=admin@menusa.example.com

# Email (Resend) — required for waitlist confirmation, promotion, verification, broadcast.
EMAIL_FROM="Menusa <hello@menusa.example.com>"
RESEND_API_KEY=re_xxx
